# Скопируйте в .env: cp .env.example .env
# Без изменений проект работает офлайн: LLM_PROVIDER=fake, AMOCRM_MODE=mock.

# --- Сервис ---
# Уровень логов: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Каталог с YAML базы знаний
KB_PATH=data/kb
# Retrieval: auto (вся БЗ в промпт, пока она маленькая) | full | keyword (BM25 top-k), см. ADR-001
KB_RETRIEVER=auto

# --- LLM ---
# fake — детерминированный офлайн-провайдер (без ключа); anthropic — реальная модель
LLM_PROVIDER=fake
LLM_MODEL=claude-opus-5-5
# Передаётся только моделям, которые принимают sampling-параметры (см. README, «Допущения»)
LLM_TEMPERATURE=0.2
# Общий дедлайн на вызов LLM (включая повтор), секунды; по истечении — шаблонный фолбэк
LLM_TIMEOUT_S=15
# Нужен только при LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# --- amoCRM ---
# mock — примечания пишутся в лог и демо UI; live — в сделку через API amoCRM
AMOCRM_MODE=mock
# Нужны только при AMOCRM_MODE=live: поддомен (<subdomain>.amocrm.ru) и долгосрочный токен интеграции
# AMOCRM_SUBDOMAIN=
# AMOCRM_ACCESS_TOKEN=
